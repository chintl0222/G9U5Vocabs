function famHTML(f){
  if(f==='—') return `<span class="chip none">Chưa có từ cùng họ</span>`;
  return f.split(', ').map(x=>{const m=x.match(/^(.*?)\s*\((.*)\)$/);const w=m?m[1]:x,p=m?m[2]:'';return `<button class="chip" type="button" data-say="${esc(speakable(w))}" data-rate="0.9" aria-label="Nghe từ ${esc(w)}">${esc(w)}<i>${esc(p)}</i></button>`;}).join('');
}
function exHTML(wd){
  const i=wd.ex.toLowerCase().indexOf(wd.hl.toLowerCase());
  if(i<0) return esc(wd.ex);
  return esc(wd.ex.slice(0,i))+'<mark>'+esc(wd.ex.slice(i,i+wd.hl.length))+'</mark>'+esc(wd.ex.slice(i+wd.hl.length));
}

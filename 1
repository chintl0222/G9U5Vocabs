        <button class="btn slow" type="button" data-say="${esc(speakable(wd.w))}" data-rate="0.5">Đọc chậm</button>
      </div>
      <div><p class="lbl">Nghĩa</p><p class="mean">${esc(wd.vi)}</p></div>
      <div><p class="lbl">Ví dụ</p>
        <div class="ex"><button class="say small" type="button" data-say="${esc(wd.ex)}" data-rate="0.9" aria-label="Nghe câu ví dụ">${spk}</button><p>${exHTML(wd)}</p></div>
      </div>
      <div><p class="lbl">Họ từ · Word family</p><div class="fam">${famHTML(wd.fam)}</div></div>
    </div>
  </section>`;
}
function coverSlide(){
  const pick=[0,2,12,11,18,3];
  const tiles=pick.map(k=>`<div class="tile" style="--c:${PAL[WORDS[k].p].acc}">${svgWrap(k,ART[k](),WORDS[k].w)}</div>`).join('');
  return `<section class="slide cover" hidden style="--acc:#ffd23f;--tint:#fff6cf">
    <div class="copy"><p class="eyebrow">UNIT 5</p><h1>Our Experiences</h1>
      <p class="sub">Từ vựng và cụm từ · ${N} từ · kèm phát âm giọng Mỹ</p>
      <div class="row"><button class="btn acc big" type="button" data-go="1">Bắt đầu học</button>
      <button class="btn big" type="button" data-say="Our Experiences" data-rate="0.85">${spk} Nghe tên bài</button></div></div>
    <div class="tiles">${tiles}</div></section>`;
}
function endSlide(){
  return `<section class="slide end" hidden style="--acc:#b79cff;--tint:#eadffd">
    <div class="art"><div class="disc">${svgWrap(0,ART[0](),'Ngôi sao vui vẻ')}</div></div>
    <div class="copy"><h2>Hoàn thành Unit 5!</h2><p>Bạn đã xem hết ${N} từ. Quay lại nghe lại những từ còn lạ nhé.</p>
      <div class="row"><button class="btn acc big" type="button" data-go="1">Học lại từ đầu</button><button class="btn big" type="button" id="open2">Danh sách từ</button></div></div>
  </section>`;
}

/* ---------- Build ---------- */
const stage=document.getElementById('stage');
stage.innerHTML=coverSlide()+WORDS.map((_,k)=>wordSlide(k)).join('')+endSlide();
const slides=[...stage.children];
const items=document.getElementById('items');
items.innerHTML=WORDS.map((wd,k)=>`<button class="item" type="button" data-go="${k+1}" style="--c:${PAL[wd.p].tint}"><small>${k+1}</small>${esc(wd.w)}</button>`).join('');

/* ---------- Speech (US English) ---------- */
let voice=null,autoRead=false,toastTimer=null;
const hasSpeech='speechSynthesis' in window;
function pickVoice(){
  if(!hasSpeech) return;
  const v=speechSynthesis.getVoices().filter(x=>/^en[-_]US$/i.test(x.lang));
  voice=v.find(x=>/(Samantha|Google US|Aria|Jenny|Ava|Allison|Zira|Natural)/i.test(x.name))||v[0]||null;
}
if(hasSpeech){pickVoice();speechSynthesis.onvoiceschanged=pickVoice;}
function toast(t){
  const el=document.getElementById('toast');el.textContent=t;el.hidden=false;
  clearTimeout(toastTimer);toastTimer=setTimeout(()=>{el.hidden=true;},3200);
}
function say(text,rate,btn){
  if(!hasSpeech){toast('Trình duyệt này chưa hỗ trợ đọc to.');return;}
  document.querySelectorAll('.playing').forEach(b=>b.classList.remove('playing'));
  speechSynthesis.cancel();
  const u=new SpeechSynthesisUtterance(text);
  u.lang='en-US';u.rate=rate||0.9;u.pitch=1.05;
  if(voice) u.voice=voice;
  if(btn){u.onstart=()=>btn.classList.add('playing');u.onend=u.onerror=()=>btn.classList.remove('playing');}
  speechSynthesis.speak(u);
}

/* ---------- Navigation ---------- */
let cur=0;
function go(n){
  n=Math.max(0,Math.min(LAST,n));
  slides.forEach((s,i)=>{s.hidden=i!==n;s.classList.remove('in');});
  const s=slides[n];void s.offsetWidth;s.classList.add('in');
  cur=n;
  const w=n>=1&&n<=N?WORDS[n-1]:null,pal=w?PAL[w.p]:(n===0?PAL[0]:PAL[4]);
  const r=document.documentElement.style;
  r.setProperty('--stage',pal.tint);r.setProperty('--tint',pal.tint);r.setProperty('--acc',pal.acc);
  document.getElementById('count').textContent=(n+1)+' / '+(LAST+1);
  const pct=Math.round(Math.min(n,N)/N*100);
  const f=document.getElementById('fill');f.style.setProperty('--pct',pct+'%');
  f.parentElement.setAttribute('aria-valuenow',Math.min(n,N));
  document.getElementById('prev').disabled=n===0;
  document.getElementById('next').disabled=n===LAST;
  document.getElementById('prev').style.opacity=n===0?.45:1;
  document.getElementById('next').style.opacity=n===LAST?.45:1;
  if(hasSpeech) speechSynthesis.cancel();
  try{history.replaceState(null,'',n>=1&&n<=N?'#word-'+n:'#'+(n===0?'cover':'finish'));}catch(e){}
  window.scrollTo({top:0});
  if(autoRead&&w) say(speakable(w.w),0.85,s.querySelector('.say'));
}
document.getElementById('prev').onclick=()=>go(cur-1);
document.getElementById('next').onclick=()=>go(cur+1);
const menu=document.getElementById('menu');
const openMenu=()=>{menu.hidden=false;};
const closeMenu=()=>{menu.hidden=true;};
document.getElementById('open').onclick=openMenu;
document.getElementById('close').onclick=closeMenu;
menu.addEventListener('click',e=>{if(e.target===menu)closeMenu();});
document.getElementById('auto').onclick=function(){
  autoRead=!autoRead;this.setAttribute('aria-pressed',autoRead);this.textContent='Tự đọc: '+(autoRead?'Bật':'Tắt');
};
document.addEventListener('click',e=>{
  const g=e.target.closest('[data-go]');
  if(g){closeMenu();go(parseInt(g.dataset.go,10));return;}
  if(e.target.id==='open2'){openMenu();return;}
  const b=e.target.closest('[data-say]');
  if(b) say(b.dataset.say,parseFloat(b.dataset.rate)||0.9,b);
});
document.addEventListener('keydown',e=>{
  if(e.key==='Escape'){closeMenu();return;}
  if(!menu.hidden) return;
  if(e.key==='ArrowRight') go(cur+1);
  if(e.key==='ArrowLeft') go(cur-1);
});
let tx=null;
stage.addEventListener('touchstart',e=>{tx=e.touches[0].clientX;},{passive:true});
stage.addEventListener('touchend',e=>{
  if(tx===null) return;
  const dx=e.changedTouches[0].clientX-tx;tx=null;
  if(Math.abs(dx)>70) go(cur+(dx<0?1:-1));
},{passive:true});
document.documentElement.lang='vi';
const m=/^#word-(\d+)$/.exec(location.hash||'');
go(m?Math.min(N,Math.max(1,parseInt(m[1],10))):0);
</script>

</body></html>

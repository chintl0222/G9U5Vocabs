<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Unit 5 Our Experiences</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Nunito:wght@400;600;700;800&display=swap">
<style>
/* Layout: one slide at a time. Left a cartoon illustration card, right a white word card (word, US audio, meaning, example, word family). Bottom bar with prev/next and progress. */
:root{
  --ink:#2b2a4c;
  --ink-soft:#5a5880;
  --paper:#ffffff;
  --stage:#fff6cf;
  --tint:#fff6cf;
  --acc:#ffd23f;
  --grape:#7a5af5;
  --font-display:'Fredoka','Nunito',system-ui,sans-serif;
  --font-body:'Nunito',system-ui,sans-serif;
  --font-ipa:'Noto Sans','Segoe UI','DejaVu Sans',system-ui,sans-serif;
  color-scheme:light;
}
*{box-sizing:border-box}
body{
  margin:0;background:var(--stage);color:var(--ink);font-family:var(--font-body);font-size:18px;line-height:1.45;
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
  padding-block:16px 24px;
  transition:background .4s ease;
}
.app{max-width:1120px;margin:0 auto;display:flex;flex-direction:column;gap:18px}
button{font:inherit;color:inherit}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  font-weight:800;font-size:16px;background:var(--paper);color:var(--ink);
  border:3px solid var(--ink);border-radius:999px;padding:8px 18px;cursor:pointer;
  box-shadow:0 4px 0 var(--ink);transition:transform .08s,box-shadow .08s;
}
.btn:active{transform:translateY(3px);box-shadow:0 1px 0 var(--ink)}
.btn:focus-visible,.chip:focus-visible,.item:focus-visible{outline:4px solid var(--grape);outline-offset:3px}
.btn.acc{background:var(--acc)}
.btn.big{font-size:20px;padding:12px 26px}
.btn[aria-pressed="true"]{background:var(--acc)}
.btn svg{width:20px;height:20px}
header{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:600;font-size:22px}
.brand b{background:var(--acc);border:3px solid var(--ink);border-radius:14px;padding:2px 12px;font-weight:700;transition:background .4s}
.tools{display:flex;flex-wrap:wrap;align-items:center;gap:10px}
.count{font-family:var(--font-display);font-weight:600;font-size:20px;min-width:64px;text-align:center}
#stage{min-width:0}
.slide{display:grid;grid-template-columns:5fr 6fr;gap:26px;align-items:stretch}
.slide[hidden]{display:none}
.art{
  position:relative;background:var(--acc);border:3px solid var(--ink);border-radius:36px;box-shadow:0 8px 0 var(--ink);
  display:grid;place-items:center;padding:clamp(16px,3vw,30px);min-width:0;overflow:hidden;transition:background .4s;
}
.disc{width:100%;max-width:430px;aspect-ratio:1;border-radius:38%;background:rgba(255,255,255,.86);display:grid;place-items:center}
.disc svg{width:94%;height:auto;display:block;animation:bob 3.4s ease-in-out infinite}
@keyframes bob{50%{transform:translateY(-7px) rotate(-1.2deg)}}
@keyframes pop{from{transform:scale(.88);opacity:.2}to{transform:scale(1);opacity:1}}
.slide.in .art,.slide.in .info{animation:pop .45s cubic-bezier(.2,1.3,.4,1)}
.info{
  background:var(--paper);border:3px solid var(--ink);border-radius:36px;box-shadow:0 8px 0 var(--ink);
  padding:clamp(20px,3.2vw,36px);display:flex;flex-direction:column;gap:16px;min-width:0;
}
.meta{display:flex;flex-wrap:wrap;align-items:center;gap:10px}
.pos{background:var(--acc);border:2.5px solid var(--ink);border-radius:999px;padding:2px 14px;font-weight:800;font-size:17px;transition:background .4s}
.posvi{color:var(--ink-soft);font-weight:700;font-size:16px}
.num{margin-left:auto;font-family:var(--font-display);font-weight:600;color:var(--ink-soft)}
.word{margin:0;font-family:var(--font-display);font-weight:700;font-size:clamp(40px,5.4vw,70px);line-height:1.02;overflow-wrap:anywhere;text-wrap:balance}
.sayrow{display:flex;flex-wrap:wrap;align-items:center;gap:12px}
.say{
  width:62px;height:62px;border-radius:50%;background:var(--acc);border:3px solid var(--ink);box-shadow:0 5px 0 var(--ink);
  display:grid;place-items:center;cursor:pointer;flex:none;transition:transform .08s,box-shadow .08s,background .4s;
}
.say:active{transform:translateY(4px);box-shadow:0 1px 0 var(--ink)}
.say:focus-visible{outline:4px solid var(--grape);outline-offset:3px}
.say svg{width:30px;height:30px}
.say.small{width:46px;height:46px;box-shadow:0 4px 0 var(--ink)}
.say.small svg{width:22px;height:22px}
.say.playing{animation:ring .7s ease-in-out infinite}
@keyframes ring{50%{transform:scale(1.1)}}
.ipa{font-family:var(--font-ipa);font-size:clamp(22px,2.6vw,30px);font-weight:600;letter-spacing:.01em}
.us{font-size:13px;font-weight:800;letter-spacing:.08em;border:2px solid var(--ink);border-radius:8px;padding:0 7px;color:var(--ink)}
.slow{font-size:14px;padding:5px 12px;box-shadow:0 3px 0 var(--ink)}
.lbl{font-size:13px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-soft);margin:0 0 4px}
.mean{margin:0;font-size:clamp(22px,2.6vw,28px);font-weight:800;line-height:1.25}
.ex{display:flex;gap:12px;align-items:flex-start;background:var(--tint);border-radius:22px;padding:14px 16px;transition:background .4s}
.ex p{margin:0;font-size:clamp(17px,1.9vw,20px);font-weight:600;min-width:0}
mark{background:var(--acc);color:var(--ink);border-radius:7px;padding:0 5px;font-weight:800;transition:background .4s}
.fam{display:flex;flex-wrap:wrap;gap:8px}
.chip{
  font-weight:700;font-size:16px;background:var(--paper);border:2.5px solid var(--ink);border-radius:999px;padding:3px 13px;cursor:pointer;
}
.chip:active{background:var(--tint)}
.chip i{font-style:normal;color:var(--ink-soft);font-weight:700;margin-left:4px}
.chip.none{cursor:default;color:var(--ink-soft)}
.cover{align-items:center}
.cover .copy{display:flex;flex-direction:column;gap:18px;align-items:flex-start;min-width:0}
.eyebrow{margin:0;background:var(--acc);border:3px solid var(--ink);border-radius:999px;padding:3px 18px;font-family:var(--font-display);font-weight:700;font-size:20px;letter-spacing:.06em}
.cover h1{margin:0;font-family:var(--font-display);font-weight:700;font-size:clamp(46px,8vw,96px);line-height:.98;text-wrap:balance}
.cover .sub{margin:0;font-size:clamp(19px,2.4vw,24px);font-weight:700;color:var(--ink-soft)}
.row{display:flex;flex-wrap:wrap;gap:14px}
.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.tile{border:3px solid var(--ink);border-radius:28px;box-shadow:0 5px 0 var(--ink);background:var(--c);padding:6px;min-width:0}
.tile svg{width:100%;height:auto;display:block;background:rgba(255,255,255,.8);border-radius:22px}
.tile:nth-child(2n) svg{animation:bob 3.4s ease-in-out infinite .5s}
.tile:nth-child(3n) svg{animation:bob 3.4s ease-in-out infinite 1s}
.end .art{min-height:300px}
.end .copy{display:flex;flex-direction:column;gap:18px;justify-content:center;align-items:flex-start;background:var(--paper);border:3px solid var(--ink);border-radius:36px;box-shadow:0 8px 0 var(--ink);padding:clamp(20px,3.2vw,36px)}
.end h2{margin:0;font-family:var(--font-display);font-size:clamp(38px,5.6vw,64px);line-height:1.05}
.end p{margin:0;font-size:20px;font-weight:700;color:var(--ink-soft)}
nav{display:flex;align-items:center;gap:14px}
.track{flex:1;height:16px;background:var(--paper);border:3px solid var(--ink);border-radius:999px;overflow:hidden;min-width:0}
.fill{height:100%;width:var(--pct,0%);background:var(--acc);border-right:3px solid var(--ink);transition:width .35s ease,background .4s}
.fill[style*="--pct:0%"]{border-right:0}
.hint{font-size:14px;font-weight:700;color:var(--ink-soft);text-align:center;margin:0}
.menu{position:fixed;inset:0;z-index:20;background:rgba(43,42,76,.55);display:grid;place-items:center;padding:16px}
.panel{background:var(--paper);border:3px solid var(--ink);border-radius:32px;box-shadow:0 8px 0 var(--ink);padding:22px;width:min(920px,100%);max-height:88vh;overflow:auto}
.panel h2{margin:0 0 14px;font-family:var(--font-display);font-size:28px;display:flex;justify-content:space-between;align-items:center;gap:12px}
.items{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.item{background:var(--c);border:2.5px solid var(--ink);border-radius:16px;padding:8px 12px;text-align:left;font-weight:800;font-size:16px;cursor:pointer;display:flex;gap:8px;align-items:baseline;min-width:0;overflow-wrap:anywhere}
.item small{font-family:var(--font-display);color:var(--ink-soft);font-size:14px}
.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:#fff;border-radius:999px;padding:10px 20px;font-weight:700;font-size:15px;z-index:30;max-width:92vw;text-align:center}
@media (max-width:820px){
  .slide{grid-template-columns:1fr;gap:20px}
  .disc{max-width:300px}
  .hint{display:none}
  .btn.big{font-size:18px}
}
@media (prefers-reduced-motion:reduce){
  *{animation:none!important;transition:none!important}
}
</style>

<div class="app">
  <header>
    <div class="brand"><b>UNIT 5</b><span>Our Experiences</span></div>
    <div class="tools">
      <button class="btn" id="auto" aria-pressed="false" type="button">Tự đọc: Tắt</button>
      <button class="btn" id="open" type="button">Danh sách từ</button>
      <span class="count" id="count" aria-live="polite">1 / 27</span>
    </div>
  </header>
  <main id="stage"></main>
  <nav>
    <button class="btn" id="prev" type="button" aria-label="Từ trước">&#8592; Trước</button>
    <div class="track" role="progressbar" aria-valuemin="0" aria-valuemax="25" aria-valuenow="0"><div class="fill" id="fill" style="--pct:0%"></div></div>
    <button class="btn acc" id="next" type="button" aria-label="Từ tiếp theo">Tiếp &#8594;</button>
  </nav>
  <p class="hint">Dùng phím ← → để chuyển từ. Bấm nút loa để nghe giọng Mỹ (giọng đọc tuỳ thiết bị của bạn).</p>
</div>

<div class="menu" id="menu" hidden>
  <div class="panel" role="dialog" aria-label="Danh sách từ vựng">
    <h2>Danh sách từ vựng <button class="btn" id="close" type="button">Đóng</button></h2>
    <div class="items" id="items"></div>
  </div>
</div>
<div class="toast" id="toast" hidden></div>

<script>
/* ---------- Illustration kit ---------- */
const K='#2b2a4c';
const S=(w=3.5)=>`stroke="${K}" stroke-width="${w}" stroke-linejoin="round" stroke-linecap="round"`;
const P=(d,f,w)=>`<path d="${d}" fill="${f}" ${S(w)}/>`;
const C=(x,y,r,f,w)=>`<circle cx="${x}" cy="${y}" r="${r}" fill="${f}" ${S(w)}/>`;
const E=(x,y,rx,ry,f,w)=>`<ellipse cx="${x}" cy="${y}" rx="${rx}" ry="${ry}" fill="${f}" ${S(w)}/>`;
const R=(x,y,w,h,r,f,sw)=>`<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="${r}" fill="${f}" ${S(sw)}/>`;
const L=(d,w=3.5,c=K)=>`<path d="${d}" fill="none" stroke="${c}" stroke-width="${w}" stroke-linecap="round" stroke-linejoin="round"/>`;
const G=(t,inner)=>`<g transform="${t}">${inner}</g>`;
const thick=(d,c,w)=>L(d,w+7,K)+L(d,w,c);
const raw=(x,y,rx,ry,f,o=1)=>`<ellipse cx="${x}" cy="${y}" rx="${rx}" ry="${ry}" fill="${f}" opacity="${o}"/>`;
const dot=(x,y,r,f=K)=>`<circle cx="${x}" cy="${y}" r="${r}" fill="${f}"/>`;
const spark=(x,y,s,c='#fff')=>`<path transform="translate(${x} ${y}) scale(${s})" d="M0 -10Q2 -2 10 0Q2 2 0 10Q-2 2 -10 0Q-2 -2 0 -10Z" fill="${c}" stroke="${K}" stroke-width="${(2.4/s).toFixed(2)}" stroke-linejoin="round"/>`;
const heart=(x,y,s,c)=>`<path transform="translate(${x} ${y}) scale(${s})" d="M0 10C-14 0 -10 -10 -4 -9C-2 -9 0 -7 0 -5C0 -7 2 -9 4 -9C10 -10 14 0 0 10Z" fill="${c}" stroke="${K}" stroke-width="${(3/s).toFixed(2)}" stroke-linejoin="round"/>`;
const star=(cx,cy,Ro,ri,f,w=3)=>{const p=[];for(let i=0;i<10;i++){const a=-Math.PI/2+i*Math.PI/5,q=i%2?ri:Ro;p.push((cx+q*Math.cos(a)).toFixed(1)+','+(cy+q*Math.sin(a)).toFixed(1));}return `<polygon points="${p.join(' ')}" fill="${f}" ${S(w)}/>`;};
const bub=(x,y,r)=>`<circle cx="${x}" cy="${y}" r="${r}" fill="#fff" fill-opacity=".7" stroke="${K}" stroke-width="2.5"/>`;
const note=(x,y,c)=>`<ellipse cx="${x}" cy="${y}" rx="8" ry="6" fill="${c}" ${S(2.8)} transform="rotate(-20 ${x} ${y})"/>`+L(`M${x+7} ${y-1}V${y-26}Q${x+16} ${y-22} ${x+14} ${y-12}`,3.2);
const T=(x,y,t,sz,f,st)=>`<text x="${x}" y="${y}" text-anchor="middle" font-family="Fredoka,Nunito,sans-serif" font-weight="700" font-size="${sz}" fill="${f}" ${st?`stroke="${K}" stroke-width="3" paint-order="stroke" stroke-linejoin="round"`:''}>${t}</text>`;
function face(x,y,s,m){
  const eye=(cx,r)=>`<ellipse cx="${cx}" cy="-4" rx="4.2" ry="${r}" fill="${K}"/><circle cx="${cx+1.5}" cy="${(-4-r*.45).toFixed(1)}" r="1.6" fill="#fff"/>`;
  const arc=cx=>L(`M${cx-5.5} -2Q${cx} -10 ${cx+5.5} -2`,3.4);
  const tear=sx=>`<path d="M${sx} 2q-4 7 0 9q4 -2 0 -9Z" fill="#8fdcff" stroke="${K}" stroke-width="1.6"/>`;
  let e='',mo='',ex='',blush=true;
  switch(m){
    case 'wow': e=eye(-15,6.4)+eye(15,6.4); mo=`<ellipse cx="0" cy="13" rx="5.5" ry="7" fill="${K}"/><ellipse cx="0" cy="16" rx="3.2" ry="2.6" fill="#ff7a8a"/>`;break;
    case 'grin': e=eye(-15,5.4)+eye(15,5.4); mo=`<path d="M-11 6Q0 26 11 6Z" fill="${K}" ${S(3)}/><path d="M-5 15Q0 20 5 15Q0 11 -5 15Z" fill="#ff7a8a"/>`;break;
    case 'sad': e=eye(-15,5)+eye(15,5); ex=L('M-22 -13L-9 -18',3)+L('M22 -13L9 -18',3); mo=L('M-8 16Q0 8 8 16',3.2);break;
    case 'worry': e=eye(-15,5.6)+eye(15,5.6); ex=L('M-22 -13L-9 -18',3)+L('M22 -13L9 -18',3)+tear(-27); mo=L('M-9 14Q-4.5 9 0 14T9 14',3.2);break;
    case 'grumpy': e=eye(-15,4.2)+eye(15,4.2); ex=L('M-23 -19L-8 -12',3.2)+L('M23 -19L8 -12',3.2); mo=L('M-8 15Q0 8 8 15',3.2); blush=false;break;
    case 'shy': e=arc(-15)+arc(15); mo=L('M-4 10Q0 13.5 4 10',3.2);break;
    case 'touch': e=arc(-15)+arc(15); ex=tear(-21)+tear(21); mo=L('M-8 8Q0 17 8 8',3.2);break;
    case 'proud': e=arc(-15)+arc(15); mo=`<path d="M-10 6Q0 22 10 6Z" fill="${K}" ${S(3)}/>`;break;
    default: e=eye(-15,5.2)+eye(15,5.2); mo=L('M-8 8Q0 17 8 8',3.2);
  }
  const b=blush?`<ellipse cx="-25" cy="8" rx="6.5" ry="4.2" fill="#ff8fa3" opacity=".75"/><ellipse cx="25" cy="8" rx="6.5" ry="4.2" fill="#ff8fa3" opacity=".75"/>`:'';
  return `<g transform="translate(${x} ${y}) scale(${s})">${b}${e}${ex}${mo}</g>`;
}

/* ---------- 25 illustrations (order matches WORDS) ---------- */
const ART=[
/* amazing */ ()=>star(120,128,70,34,'#ffd23f',5)+face(120,128,1.05,'wow')+spark(38,60,1.3)+spark(204,50,1)+spark(208,172,1.2,'#ffd23f')+spark(32,176,.9,'#ffd23f'),
/* army-like */ ()=>E(120,214,70,9,'#d6dcf0',3)+C(120,142,56,'#ffd9b3',4)+P('M60 134Q60 66 120 66Q180 66 180 134Z','#6ab04c',4)+P('M48 134H192Q192 148 178 148H62Q48 148 48 134Z','#4a8a35',4)+star(120,102,15,7,'#ffd23f',3)+L('M82 118Q120 108 158 118',3,'#4a8a35')+face(120,172,.85,'proud'),
/* brilliant */ ()=>{let r='';for(let i=0;i<9;i++){const a=(-160+i*20)*Math.PI/180;r+=L(`M${(120+70*Math.cos(a)).toFixed(1)} ${(100+70*Math.sin(a)).toFixed(1)}L${(120+92*Math.cos(a)).toFixed(1)} ${(100+92*Math.sin(a)).toFixed(1)}`,6,'#ff9f43');}
  return r+P('M120 45C168 45 188 85 172 118C164 134 152 140 148 155H92C88 140 76 134 68 118C52 85 72 45 120 45Z','#ffe66d',4)+R(95,152,50,36,10,'#b8c1ec',4)+L('M100 166H140M102 178H138',3)+face(120,105,1.1,'grin')+spark(44,160,1)+spark(200,168,1.1,'#ffd23f');},
/* campus */ ()=>E(120,206,104,12,'#9be3a8',3)+R(204,160,10,40,3,'#a0522d',3)+C(209,142,26,'#3ddc97',3.5)+L('M120 52V26',3.5)+P('M120 26L148 35L120 44Z','#ff4d6d',3)+P('M44 110L120 54L196 110Z','#ee6c4d',4)+R(58,108,124,92,8,'#ffd6a5',4)+R(70,120,26,26,5,'#a0e7ff',3)+R(144,120,26,26,5,'#a0e7ff',3)+R(70,156,26,26,5,'#a0e7ff',3)+R(144,156,26,26,5,'#a0e7ff',3)+P('M104 200V170Q104 158 120 158Q136 158 136 170V200Z','#4cc9f0',3.5)+C(120,88,14,'#fff',3)+L('M120 88V79M120 88L127 92',3)+face(120,136,.68,'happy'),
/* confidence */ ()=>P('M82 104L34 198Q120 216 206 198L158 104Z','#ff6b6b',4)+C(120,144,54,'#4cc9f0',4)+C(66,172,12,'#4cc9f0',3.5)+C(174,172,12,'#4cc9f0',3.5)+P('M92 94L98 66L112 82L120 62L128 82L142 66L148 94Z','#ffd23f',3.5)+face(120,148,1.05,'proud')+spark(40,70,1.2)+spark(204,80,1,'#ffd23f'),
/* coral reef */ ()=>R(25,35,190,170,30,'#bdeeff',4)+P('M25 168Q70 150 120 166T215 160V178Q215 205 185 205H55Q25 205 25 178Z','#ffe3a3',4)+thick('M70 192V142M70 168L52 142M70 158L90 130','#ff6b8a',11)+thick('M165 192V152M165 172L186 144M165 162L148 138','#ff9f43',11)+C(118,190,23,'#c19bff',3.5)+face(118,192,.55,'happy')+E(136,96,24,16,'#ffd23f',3.5)+P('M112 96L92 80V112Z','#ff9f43',3.5)+L('M129 83Q123 96 129 109',3)+dot(146,92,4)+L('M148 103Q152 105 156 102',2.5)+bub(172,68,7)+bub(184,50,5)+bub(60,82,6),
